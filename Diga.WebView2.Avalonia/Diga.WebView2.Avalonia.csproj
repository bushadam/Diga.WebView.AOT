<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Diga.WebView2.Avalonia.AOT</PackageId>
    <Title>Diga.WebView2.Avalonia.AOT</Title>
    <Version>1.0.0-preview.1</Version>
    <Description>Avalonia 12 host control for Diga.WebView2.Wrapper (Native AOT friendly, SimdSkia compatible).</Description>
    <PackageTags>WebView2;Avalonia;AOT</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[12.1.4]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diga.WebView2.Interop\Diga.WebView2.Interop.csproj" />
    <ProjectReference Include="..\Diga.WebView2.Wrapper\Diga.WebView2.Wrapper.csproj" />
  </ItemGroup>

</Project>
